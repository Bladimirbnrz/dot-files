{
    "program": {
        "prefix": ["program"],
        "body": [
            "! Objetivo: $1\n",
            "program ${2: program_name}",
            "\timplicit none",
            "\t$0",
            "\nend program"
        ],
        "description": "Some Program",
        "scope": "source.fortran"
    },
    "module": {
        "prefix": ["module"],
        "body": [
            "module ${1: module_name}",
            "\timplicit none",
            "\t$0",
            "end module"
        ],
        "description": "description"
    },
    "subroutine": {
        "prefix": ["subroutine"],
        "body": [
            "subroutine ${1:subroutine_name}(${args})",
            "\t$0",
            "end subroutine"
        ],
        "description": "Add a Subroutine"
    },
    "func": {
        "prefix": ["function"],
        "body": [
            "${1:type} function ${2:func}(${3:args})",
            "\timplicit none",
            "\t$0",
            "end function"
        ],
        "description": "Add a function"
    },
    "write": {
        "prefix": ["write"],
        "body": ["write(${1:*},${2:*}) $0"],
        "description": "Default WRITE with no arguments"
    },
    "read": {
        "prefix": ["read"],
        "body": ["read(${1:*},${2:*}) $0"],
        "description": "Default READ with no arguments",
        "scope": "source.fortran"
    },
    "if": {
        "prefix": "if",
        "body": "if ($1) then\n\t$0\nend if",
        "description": "if",
        "scope": "source.fortran"
    },
    "do": {
        "prefix": "do",
        "body": ["do ${1:i}=${2:0}, ${3:100}\n\t$0\nend do"],
        "description": "DO Loop",
        "scope": "source.fortran"
    },
    "dowhile": {
        "prefix": ["dowhile"],
        "body": [
            "do while ($1)",
            "\t$0",
            "end do"
        ],
        "description": "DO-WHILE Loop",
        "scope": "source.fortran"
    }
}
