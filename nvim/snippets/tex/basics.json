{
    "usepackage": {
        "prefix": ["\\usepackage"],
        "body": ["\\usepackage{$1}"],
        "description": "Add an usepackage"
    },
    "env": {
        "prefix": ["begin", "\\begin"],
        "body": [
            "\\begin{$1}",
            "\t$0",
            "\\end{$1}"
        ],
        "description": "Env"
    },
    "equation": {
        "prefix": ["equation"],
        "body": [
            "\\begin{equation}",
            "\t$0",
            "\\end{equation}"
        ],
        "description": "Equation"
    },
    "equation*": {
        "prefix": ["equation*"],
        "body": [
            "\\begin{equation*}",
            "\t$0",
            "\\end{equation*}"
        ],
        "description": "Equation*"
    },
    "Align(ed)": {
        "prefix": ["align"],
        "body": ["\\begin{align}", "\t$0", "\\end{align}"],
        "description": "Align(ed)"
    },
    "Align*(ed)": {
        "prefix": ["align*"],
        "body": ["\\begin{align*}", "\t$0", "\\end{align*}"],
        "description": "Align*(ed)"
    },
    "author": {
        "prefix": ["\\author"],
        "body": ["\\author{$1}$0"],
        "description": "Author"
    },
    "date": {
        "prefix": ["\\date"],
        "body": ["\\date{$1}$0"],
        "description": "Date"
    },
    "title": {
        "prefix": ["\\title"],
        "body": ["\\title{$1}$0"],
        "description": "titile"
    }
}
